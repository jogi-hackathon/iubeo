{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": true,
  "arrowParens": "always",
  "bracketSameLine": false,
  // Google style: 中括弧の内側にスペースを入れない {a: 1}
  "bracketSpacing": false,
  "objectWrap": "preserve",
  // Google style: LF endings + final newline
  "endOfLine": "lf",
  "insertFinalNewline": true,
  "sortImports": true,
  "sortPackageJson": false,
  // Markdown は mdformat(pre-commit)が担当する。oxfmt と表のパディング規則が
  // 逆(mdformat は削る / oxfmt は揃える)なので、両方を満たすことはできない。
  // pre-commit 側に合わせて、oxfmt からは Markdown を外す
  "ignorePatterns": ["**/*.md"]
}
