{
  "name": "iubeo-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "bake:ao": "node scripts/bake-ao.ts",
    "gen:api": "openapi-typescript ../backend/api/openapi.yaml -o src/net/schema.gen.ts && oxfmt --write src/net/schema.gen.ts",
    "lint": "oxlint . && oxfmt --check .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "three-mesh-bvh": "^0.9.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "openapi-typescript": "7.13.0",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "playwright-core": "1.63.0",
    "potpack": "2.1.0",
    "typescript": "npm:typescript@5.9.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
