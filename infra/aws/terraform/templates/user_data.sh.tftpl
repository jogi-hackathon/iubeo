#!/bin/bash
set -euo pipefail

# AL2023 の既定リポジトリには AWS CLI が無いので、公式インストーラで入れる
# (ECR からの pull に aws ecr get-login-password が要る)
dnf install -y docker unzip
systemctl enable --now docker

if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" -o /tmp/awscli.zip
  unzip -q /tmp/awscli.zip -d /tmp
  /tmp/aws/install --update
  rm -rf /tmp/aws /tmp/awscli.zip
fi

install -d -m 0750 /etc/iubeo

if [ ! -f /etc/iubeo/env ]; then
  SIGNING_KEY=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
  WISP_KEY=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
  {
    echo "IUBEO_ADDR=:8080"
    echo "IUBEO_SIGNING_KEY=$SIGNING_KEY"
    echo "IUBEO_ALLOWED_ORIGINS=${allowed_origins}"
    echo "IUBEO_MATCH_SIZE=3"
    # 待機が長いときは CPU とマッチする(1 人でも遊べる)。0 にすれば待ち続ける
    echo "IUBEO_CPU_FILL_AFTER=30s"
%{ if wisp_pass != "" ~}
    echo "IUBEO_WISP_KEY=$WISP_KEY"
    echo "IUBEO_WISP_URL=${wisp_url}"
    echo "IUBEO_WISP_PASS=${wisp_pass}"
%{ endif ~}
  } > /etc/iubeo/env
  chmod 0600 /etc/iubeo/env

  cat > /etc/iubeo/wisp-env <<EOF
PORT=8081
IUBEO_WISP_KEY=$WISP_KEY
IUBEO_WISP_REQUIRE_TOKEN=1
EOF
  chmod 0600 /etc/iubeo/wisp-env

  unset SIGNING_KEY WISP_KEY
fi

cat > /usr/local/bin/iubeo-deploy <<'SCRIPT'
set -euo pipefail
REGISTRY="__REGISTRY__"
REPOSITORY="__REPOSITORY__"
WISP_REPOSITORY="__WISP_REPOSITORY__"
REGION="__REGION__"
PARAMETER="__PARAMETER__"
WISP_PARAMETER="__WISP_PARAMETER__"
FALLBACK_TAG="__IMAGE_TAG__"
WISP_FALLBACK_TAG="__WISP_IMAGE_TAG__"

TAG=$(aws ssm get-parameter --region "$REGION" --name "$PARAMETER" \
  --query 'Parameter.Value' --output text 2>/dev/null || true)
if [ -z "$TAG" ]; then
  echo "SSM からタグを読めなかったので $FALLBACK_TAG を使う"
  TAG="$FALLBACK_TAG"
fi
echo "デプロイするタグ: $TAG"

aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$REGISTRY"
docker pull "$REPOSITORY:$TAG"
docker tag "$REPOSITORY:$TAG" iubeo-current:latest
echo "$TAG" > /etc/iubeo/image-tag
systemctl restart iubeo

WISP_TAG=$(aws ssm get-parameter --region "$REGION" --name "$WISP_PARAMETER" \
  --query 'Parameter.Value' --output text 2>/dev/null || true)
if [ -z "$WISP_TAG" ]; then
  WISP_TAG="$WISP_FALLBACK_TAG"
fi
if docker pull "$WISP_REPOSITORY:$WISP_TAG"; then
  docker tag "$WISP_REPOSITORY:$WISP_TAG" iubeo-wisp-current:latest
  echo "$WISP_TAG" > /etc/iubeo/wisp-image-tag
  systemctl restart iubeo-wisp
else
  echo "wisp イメージ $WISP_REPOSITORY:$WISP_TAG を引けなかった(未 push なら初回だけ)"
fi
SCRIPT
sed -i \
  -e "s|__REGISTRY__|${registry}|" \
  -e "s|__REPOSITORY__|${ecr_repository}|" \
  -e "s|__WISP_REPOSITORY__|${wisp_repository}|" \
  -e "s|__IMAGE_TAG__|${image_tag}|" \
  -e "s|__WISP_IMAGE_TAG__|${wisp_image_tag}|" \
  -e "s|__REGION__|${region}|" \
  -e "s|__PARAMETER__|${image_tag_parameter}|" \
  -e "s|__WISP_PARAMETER__|${wisp_image_tag_parameter}|" \
  /usr/local/bin/iubeo-deploy
chmod 0755 /usr/local/bin/iubeo-deploy

cat > /etc/systemd/system/iubeo.service <<'UNIT'
[Unit]
Description=IUBEO game backend
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f iubeo
ExecStart=/usr/bin/docker run --rm --name iubeo --memory=__MEMORY__m --env-file /etc/iubeo/env -p 8080:8080 iubeo-current:latest
ExecStop=/usr/bin/docker stop -t 10 iubeo
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
UNIT
sed -i -e "s|__MEMORY__|${container_memory}|" /etc/systemd/system/iubeo.service

cat > /etc/systemd/system/iubeo-wisp.service <<'UNIT'
[Unit]
Description=IUBEO WISP proxy
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f iubeo-wisp
ExecStart=/usr/bin/docker run --rm --name iubeo-wisp --memory=256m --env-file /etc/iubeo/wisp-env -p 8081:8081 iubeo-wisp-current:latest
ExecStop=/usr/bin/docker stop -t 10 iubeo-wisp
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
UNIT

systemctl daemon-reload
systemctl enable iubeo
systemctl enable iubeo-wisp

/usr/local/bin/iubeo-deploy || true
