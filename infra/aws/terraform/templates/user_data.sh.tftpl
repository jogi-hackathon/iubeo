#!/bin/bash
# 初回起動時に Docker と Go サーバーのコンテナを用意する。
# 値は Terraform が埋め込む。シェル変数は署名鍵の生成にしか使わない。
set -euo pipefail

# AL2023 の既定リポジトリには AWS CLI が無いので、公式インストーラで入れる
# (ECR からの pull に aws ecr get-login-password が要る)
dnf install -y docker unzip
systemctl enable --now docker

if ! command -v aws >/dev/null 2>&1; then
  curl -fsSL "https://awscli.amazonaws.com/awscli-exe-linux-aarch64.zip" -o /tmp/awscli.zip
  unzip -q /tmp/awscli.zip -d /tmp
  /tmp/aws/install --update
  rm -rf /tmp/aws /tmp/awscli.zip
fi

install -d -m 0750 /etc/iubeo

# 署名鍵は初回だけ生成する。再起動で変わると Cookie が無効になるため。
# シェル変数は Terraform の補間と衝突しないよう、中括弧なしの $VAR で書く
if [ ! -f /etc/iubeo/env ]; then
  SIGNING_KEY=$(head -c 32 /dev/urandom | od -An -tx1 | tr -d ' \n')
  {
    echo "IUBEO_ADDR=:8080"
    echo "IUBEO_SIGNING_KEY=$SIGNING_KEY"
    echo "IUBEO_ALLOWED_ORIGINS=${allowed_origins}"
    echo "IUBEO_MATCH_SIZE=3"
  } > /etc/iubeo/env
  chmod 0600 /etc/iubeo/env
  unset SIGNING_KEY
fi

# イメージを取り直して再起動するスクリプト。
# デプロイは「ローカルで build & push」→「SSM でこれを叩く」。
cat > /usr/local/bin/iubeo-deploy <<'SCRIPT'
#!/bin/bash
set -euo pipefail
REGISTRY="__REGISTRY__"
REPOSITORY="__REPOSITORY__"
IMAGE_TAG="__IMAGE_TAG__"
REGION="__REGION__"
aws ecr get-login-password --region "$REGION" | docker login --username AWS --password-stdin "$REGISTRY"
docker pull "$REPOSITORY:$IMAGE_TAG"
systemctl restart iubeo
SCRIPT
sed -i \
  -e "s|__REGISTRY__|${registry}|" \
  -e "s|__REPOSITORY__|${ecr_repository}|" \
  -e "s|__IMAGE_TAG__|${image_tag}|" \
  -e "s|__REGION__|${region}|" \
  /usr/local/bin/iubeo-deploy
chmod 0755 /usr/local/bin/iubeo-deploy

cat > /etc/systemd/system/iubeo.service <<'UNIT'
[Unit]
Description=IUBEO game backend
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Restart=always
RestartSec=5
ExecStartPre=-/usr/bin/docker rm -f iubeo
ExecStart=/usr/bin/docker run --rm --name iubeo --memory=__MEMORY__m --env-file /etc/iubeo/env -p 8080:8080 __REPOSITORY__:__IMAGE_TAG__
ExecStop=/usr/bin/docker stop -t 10 iubeo
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target
UNIT
sed -i \
  -e "s|__MEMORY__|${container_memory}|" \
  -e "s|__REPOSITORY__|${ecr_repository}|" \
  -e "s|__IMAGE_TAG__|${image_tag}|" \
  /etc/systemd/system/iubeo.service

systemctl daemon-reload
systemctl enable iubeo

# 初回はイメージがまだ push されていないので失敗してよい。
# push 後に iubeo-deploy を叩けば起動する。
/usr/local/bin/iubeo-deploy || true
