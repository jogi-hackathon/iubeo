# Replace placeholders before provisioning. This file is safe to commit; do not put credentials here.
aws_region    = "ap-northeast-1"
project_name  = "iubeo"
environment   = "prototype"
image_tag     = "bootstrap"
instance_type = "t4g.small"

# 画面と API は同じ Worker から配信するので、そのオリジンを許可する。
# サーバーは起動時にこれを検証し、空だと終了する。
allowed_origins = ["https://iubeo.thirdlf03.com"]

# WISP のトークン発行を有効にする。有効にすると、プレイヤーの Cookie がある人に期限つきトークンを発行する
# (合言葉は廃止)。Cloudflare 側の鍵の設定とは別物
wisp_enabled = true

# Voice Chat。VC サービス(別ホスト)と同じ Ed25519 の種(base64url 32 バイト)と接続先。
# 空なら VC のトークンを発行しない。種は VC ホストの /etc/vc/keys/private.jwk の d
vc_private_key   = ""
vc_signaling_url = "wss://vc.thirdlf03.com/v1/signaling"
vc_media_url     = "https://media.thirdlf03.com:4443"
